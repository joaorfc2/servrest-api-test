{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["message", "authorization"],
  "properties": {
    "message": {
      "type": "string",
      "const": "Login realizado com sucesso"
    },
    "authorization": {
      "type": "string",
      "pattern": "^Bearer\\s.+"
    }
  },
  "additionalProperties": false
}